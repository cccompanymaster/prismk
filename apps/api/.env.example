# PRISM-K API environment template
# Copy to .env (or .env.local) and fill in real values for local dev.

# PostgreSQL connection string used by Prisma.
# Example: postgresql://prismk:prismk@localhost:5432/prismk?schema=public
DATABASE_URL=

# Optional. Defaults to 4000.
PORT=4000

# Comma-separated list of allowed origins for CORS.
# Use "*" or leave blank in dev. In production, list the
# exact frontend origin(s), e.g. https://prism-k.kr
CORS_ALLOWED_ORIGINS=*

# Optional: Sentry DSN. When unset Sentry is fully disabled.
SENTRY_DSN=
SENTRY_ENV=
SENTRY_TRACES_SAMPLE_RATE=0.1
