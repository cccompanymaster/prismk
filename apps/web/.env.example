# PRISM-K web environment
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Kakao JavaScript SDK app key for kakao 공유 (loaded only when set).
# Issued from https://developers.kakao.com/console/app — JavaScript 키.
NEXT_PUBLIC_KAKAO_KEY=

# Optional: Sentry DSN. When unset Sentry is fully disabled.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENV=
SENTRY_TRACES_SAMPLE_RATE=0.1
