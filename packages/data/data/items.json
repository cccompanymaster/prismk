    { "id": 128, "dim": "S", "facet": "S2_회피", "text": "힘들 때 나는 일에 더 몰두하며 회피하는 경향이 있다.", "reverse": false, "lite": false },
    { "id": 129, "dim": "S", "facet": "S3_자기비난", "text": "스트레스 상황에서 내 자신을 책망하게 된다.", "reverse": false, "lite": true },
