    { "id": 115, "dim": "HH", "facet": "HH3_욕심없음", "text": "나는 소박한 생활에서도 만족할 수 있다.", "reverse": false, "lite": false },
    { "id": 116, "dim": "HH", "facet": "HH4_비조작성", "text": "다른 사람을 내 뜻대로 움직이게 하려고 애쓰지 않는다.", "reverse": false, "lite": false },
    { "id": 117, "dim": "HH", "facet": "HH4_비조작성", "text": "원하는 것을 얻기 위해 사람을 이용하기도 한다.", "reverse": true, "lite": false },
    { "id": 118, "dim": "HH", "facet": "HH4_비조작성", "text": "정직한 방법으로만 사람들의 협조를 구한다.", "reverse": false, "lite": true },
    { "id": 119, "dim": "HH", "facet": "HH4_비조작성", "text": "감정에 호소해서 상대를 설득하는 기술을 잘 쓴다.", "reverse": true, "lite": false },
    { "id": 120, "dim": "HH", "facet": "HH4_비조작성", "text": "나는 사람들 사이에서 영향력을 얻기 위한 전략을 짜지 않는다.", "reverse": false, "lite": false },
    { "id": 121, "dim": "V", "facet": "V_맥락변동", "text": "직장(또는 학교)에서의 나와 친구들 앞의 나는 꽤 다르다.", "reverse": false, "lite": true },
    { "id": 122, "dim": "V", "facet": "V_맥락변동", "text": "가족과 함께 있을 때와 낯선 사람들 앞에서의 나는 달라진다.", "reverse": false, "lite": false },
    { "id": 123, "dim": "V", "facet": "V_맥락변동", "text": "어떤 자리에서든 나는 늘 비슷하게 행동한다.", "reverse": true, "lite": true },
    { "id": 124, "dim": "V", "facet": "V_맥락변동", "text": "상황에 따라 내 성격이 다르게 드러난다고 느낀다.", "reverse": false, "lite": false },
    { "id": 125, "dim": "V", "facet": "V_맥락변동", "text": "사람마다 그 사람 앞에서의 내 모습이 조금씩 다르다.", "reverse": false, "lite": false },
    { "id": 126, "dim": "S", "facet": "S1_예민", "text": "압박을 받으면 평소보다 짜증이 늘고 예민해진다.", "reverse": false, "lite": true },
