  "items": [
    { "id": 1, "dim": "O", "facet": "O1_상상력", "text": "나는 종종 일어날 법한 상황을 머릿속으로 생생하게 그려본다.", "reverse": false, "lite": false },
    { "id": 2, "dim": "O", "facet": "O1_상상력", "text": "나는 풍부한 상상력을 가진 사람이다.", "reverse": false, "lite": true },
    { "id": 3, "dim": "O", "facet": "O1_상상력", "text": "나는 공상이나 백일몽에 빠지는 일이 거의 없다.", "reverse": true, "lite": false },
    { "id": 4, "dim": "O", "facet": "O1_상상력", "text": "나는 새로운 아이디어를 떠올리는 데서 즐거움을 얻는다.", "reverse": false, "lite": false },
    { "id": 5, "dim": "O", "facet": "O1_상상력", "text": "나는 책이나 영화 속 장면을 마치 직접 경험하듯 떠올리곤 한다.", "reverse": false, "lite": false },
    { "id": 6, "dim": "O", "facet": "O2_심미", "text": "나는 예술 작품이나 자연의 아름다움에 깊이 감동받곤 한다.", "reverse": false, "lite": true },
    { "id": 7, "dim": "O", "facet": "O2_심미", "text": "음악·시·그림에서 느껴지는 미묘한 정서를 잘 알아챈다.", "reverse": false, "lite": false },
    { "id": 8, "dim": "O", "facet": "O2_심미", "text": "예술이나 미적 경험은 내 삶에서 별로 중요하지 않다.", "reverse": true, "lite": false },
    { "id": 9, "dim": "O", "facet": "O2_심미", "text": "나는 일상에서 작은 아름다움을 발견하는 일이 즐겁다.", "reverse": false, "lite": false },
    { "id": 10, "dim": "O", "facet": "O2_심미", "text": "아름다운 풍경이나 음악 한 곡에 마음이 깊이 움직일 때가 있다.", "reverse": false, "lite": false },
    { "id": 11, "dim": "O", "facet": "O3_지적호기심", "text": "나는 추상적인 개념이나 이론에 대해 생각하는 것을 좋아한다.", "reverse": false, "lite": false },
    { "id": 12, "dim": "O", "facet": "O3_지적호기심", "text": "새로운 것을 배우는 일은 내게 큰 즐거움이다.", "reverse": false, "lite": true },
    { "id": 13, "dim": "O", "facet": "O3_지적호기심", "text": "복잡한 문제를 풀거나 분석하는 일을 즐긴다.", "reverse": false, "lite": false },
    { "id": 14, "dim": "O", "facet": "O3_지적호기심", "text": "나는 깊이 생각해야 하는 주제는 피하는 편이다.", "reverse": true, "lite": true },
    { "id": 15, "dim": "O", "facet": "O3_지적호기심", "text": "처음 듣는 분야의 이야기도 흥미롭게 듣게 된다.", "reverse": false, "lite": false },
    { "id": 16, "dim": "O", "facet": "O4_비관습", "text": "나는 사회의 통념에 의문을 제기하는 일이 많다.", "reverse": false, "lite": false },
    { "id": 17, "dim": "O", "facet": "O4_비관습", "text": "전통적인 방식보다 새로운 시도를 선호한다.", "reverse": false, "lite": true },
    { "id": 18, "dim": "O", "facet": "O4_비관습", "text": "대다수가 옳다고 여기는 것이라도 나는 다르게 생각할 수 있다.", "reverse": false, "lite": false },
    { "id": 19, "dim": "O", "facet": "O4_비관습", "text": "나는 익숙하고 검증된 방식을 따르는 것이 마음 편하다.", "reverse": true, "lite": false },
    { "id": 20, "dim": "O", "facet": "O4_비관습", "text": "남들과 다른 관점에서 문제를 바라보는 것을 즐긴다.", "reverse": false, "lite": false },
    { "id": 21, "dim": "C", "facet": "C1_체계성", "text": "나는 물건을 정리정돈하는 데 신경을 많이 쓴다.", "reverse": false, "lite": false },
    { "id": 22, "dim": "C", "facet": "C1_체계성", "text": "내 일정과 할 일은 체계적으로 관리되고 있다.", "reverse": false, "lite": true },
    { "id": 23, "dim": "C", "facet": "C1_체계성", "text": "내 책상이나 방은 늘 어수선한 편이다.", "reverse": true, "lite": false },
    { "id": 24, "dim": "C", "facet": "C1_체계성", "text": "나는 일을 시작하기 전에 계획을 세우는 편이다.", "reverse": false, "lite": false },
    { "id": 25, "dim": "C", "facet": "C1_체계성", "text": "나는 정리된 환경에서 더 잘 집중할 수 있다.", "reverse": false, "lite": false },
    { "id": 26, "dim": "C", "facet": "C2_근면성", "text": "나는 한번 시작한 일은 끝까지 마치는 편이다.", "reverse": false, "lite": true },
    { "id": 27, "dim": "C", "facet": "C2_근면성", "text": "어려운 일이라도 끈기 있게 매달려 해낸다.", "reverse": false, "lite": false },
    { "id": 28, "dim": "C", "facet": "C2_근면성", "text": "지루하거나 힘든 일은 쉽게 포기하는 편이다.", "reverse": true, "lite": true },
    { "id": 29, "dim": "C", "facet": "C2_근면성", "text": "내가 해야 할 일은 미루지 않고 그날 끝낸다.", "reverse": false, "lite": false },
    { "id": 30, "dim": "C", "facet": "C2_근면성", "text": "목표가 정해지면 꾸준히 노력해서 이루어낸다.", "reverse": false, "lite": false },
    { "id": 31, "dim": "C", "facet": "C3_신중성", "text": "중요한 결정을 내리기 전에 충분히 따져본다.", "reverse": false, "lite": true },
    { "id": 32, "dim": "C", "facet": "C3_신중성", "text": "나는 충동적으로 행동하기보다 신중히 생각한 후 행동한다.", "reverse": false, "lite": false },
    { "id": 33, "dim": "C", "facet": "C3_신중성", "text": "결과를 예상하지 않고 즉흥적으로 일을 벌이곤 한다.", "reverse": true, "lite": false },
    { "id": 34, "dim": "C", "facet": "C3_신중성", "text": "위험이 따르는 선택을 할 때는 매우 조심스럽다.", "reverse": false, "lite": false },
    { "id": 35, "dim": "C", "facet": "C3_신중성", "text": "새로운 일을 시작하기 전에 충분히 정보를 모은다.", "reverse": false, "lite": false },
    { "id": 36, "dim": "C", "facet": "C4_자기규율", "text": "나는 하기 싫은 일이라도 해야 한다면 해낸다.", "reverse": false, "lite": true },
    { "id": 37, "dim": "C", "facet": "C4_자기규율", "text": "유혹을 이겨내고 목표한 일을 끝까지 한다.", "reverse": false, "lite": false },
    { "id": 38, "dim": "C", "facet": "C4_자기규율", "text": "기분이 좋지 않으면 해야 할 일을 손에서 놓곤 한다.", "reverse": true, "lite": false },
    { "id": 39, "dim": "C", "facet": "C4_자기규율", "text": "나는 스스로 정한 규칙을 잘 지킨다.", "reverse": false, "lite": false },
    { "id": 40, "dim": "C", "facet": "C4_자기규율", "text": "즉각적인 만족보다 장기적인 목표를 우선한다.", "reverse": false, "lite": false },
    { "id": 41, "dim": "E", "facet": "E1_사교성", "text": "나는 여러 사람과 어울리는 자리를 즐긴다.", "reverse": false, "lite": true },
    { "id": 42, "dim": "E", "facet": "E1_사교성", "text": "낯선 사람과도 쉽게 대화를 시작할 수 있다.", "reverse": false, "lite": false },
    { "id": 43, "dim": "E", "facet": "E1_사교성", "text": "혼자 있는 시간이 사람들과의 모임보다 좋다.", "reverse": true, "lite": true },
    { "id": 44, "dim": "E", "facet": "E1_사교성", "text": "사람들과 함께 있을 때 에너지를 얻는다.", "reverse": false, "lite": false },
    { "id": 45, "dim": "E", "facet": "E1_사교성", "text": "모임이나 파티에서 자연스럽게 사람들과 어울린다.", "reverse": false, "lite": false },
    { "id": 46, "dim": "E", "facet": "E2_자기주장", "text": "회의나 토론에서 내 의견을 분명히 말한다.", "reverse": false, "lite": true },
    { "id": 47, "dim": "E", "facet": "E2_자기주장", "text": "필요할 때는 다른 사람을 이끄는 역할을 자처한다.", "reverse": false, "lite": false },
    { "id": 48, "dim": "E", "facet": "E2_자기주장", "text": "사람들 앞에서 내 입장을 밝히는 것이 부담스럽다.", "reverse": true, "lite": false },
    { "id": 49, "dim": "E", "facet": "E2_자기주장", "text": "나는 내가 원하는 것을 분명히 표현하는 사람이다.", "reverse": false, "lite": false },
    { "id": 50, "dim": "E", "facet": "E2_자기주장", "text": "다른 사람의 의견에 동의하지 않을 때는 그렇다고 말한다.", "reverse": false, "lite": false },
    { "id": 51, "dim": "E", "facet": "E3_활동성", "text": "나는 늘 바쁘고 활동적으로 지내는 것을 선호한다.", "reverse": false, "lite": true },
    { "id": 52, "dim": "E", "facet": "E3_활동성", "text": "에너지가 넘쳐서 가만히 있기 어려울 때가 많다.", "reverse": false, "lite": false },
    { "id": 53, "dim": "E", "facet": "E3_활동성", "text": "조용하고 느긋하게 시간을 보내는 것이 더 좋다.", "reverse": true, "lite": false },
    { "id": 54, "dim": "E", "facet": "E3_활동성", "text": "여러 가지 일을 한꺼번에 진행하는 것을 즐긴다.", "reverse": false, "lite": false },
    { "id": 55, "dim": "E", "facet": "E3_활동성", "text": "빠른 속도로 움직이며 일하는 것을 좋아한다.", "reverse": false, "lite": false },
    { "id": 56, "dim": "E", "facet": "E4_긍정정서", "text": "나는 평소 기분이 좋고 즐거운 편이다.", "reverse": false, "lite": true },
    { "id": 57, "dim": "E", "facet": "E4_긍정정서", "text": "잘 웃고, 작은 일에서도 기쁨을 느낀다.", "reverse": false, "lite": false },
    { "id": 58, "dim": "E", "facet": "E4_긍정정서", "text": "내 일상에 즐거운 일이 별로 없다고 느낀다.", "reverse": true, "lite": false },
    { "id": 59, "dim": "E", "facet": "E4_긍정정서", "text": "나는 활기차고 낙관적인 사람이다.", "reverse": false, "lite": false },
    { "id": 60, "dim": "E", "facet": "E4_긍정정서", "text": "좋은 일이 생기면 그 기분을 마음껏 즐긴다.", "reverse": false, "lite": false },
    { "id": 61, "dim": "A", "facet": "A1_공감", "text": "다른 사람의 감정을 잘 알아차린다.", "reverse": false, "lite": true },
    { "id": 62, "dim": "A", "facet": "A1_공감", "text": "주변 사람이 힘들어 보이면 마음이 함께 무거워진다.", "reverse": false, "lite": false },
    { "id": 63, "dim": "A", "facet": "A1_공감", "text": "타인의 감정을 이해하기보다 사실에 집중하는 편이다.", "reverse": true, "lite": false },
    { "id": 64, "dim": "A", "facet": "A1_공감", "text": "나는 다른 사람의 입장을 자연스럽게 헤아린다.", "reverse": false, "lite": false },
    { "id": 65, "dim": "A", "facet": "A1_공감", "text": "슬픈 이야기를 들으면 내 마음도 함께 아프다.", "reverse": false, "lite": false },
    { "id": 66, "dim": "A", "facet": "A2_협동성", "text": "갈등 상황에서 타협점을 찾으려 노력한다.", "reverse": false, "lite": true },
    { "id": 67, "dim": "A", "facet": "A2_협동성", "text": "내 주장보다 집단의 화합을 우선하는 편이다.", "reverse": false, "lite": false },
    { "id": 68, "dim": "A", "facet": "A2_협동성", "text": "내 의견과 다르면 끝까지 다투는 성격이다.", "reverse": true, "lite": false },
    { "id": 69, "dim": "A", "facet": "A2_협동성", "text": "팀으로 일할 때 다른 사람들과 잘 맞춰간다.", "reverse": false, "lite": false },
    { "id": 70, "dim": "A", "facet": "A2_협동성", "text": "의견 차이가 있어도 서로 양보하는 편을 택한다.", "reverse": false, "lite": false },
    { "id": 71, "dim": "A", "facet": "A3_관용", "text": "나와 다른 가치관을 가진 사람도 존중하려 노력한다.", "reverse": false, "lite": true },
    { "id": 72, "dim": "A", "facet": "A3_관용", "text": "사람들이 실수해도 너그럽게 받아들이는 편이다.", "reverse": false, "lite": false },
    { "id": 73, "dim": "A", "facet": "A3_관용", "text": "잘못한 사람은 분명히 책임져야 한다고 생각한다.", "reverse": true, "lite": false },
    { "id": 74, "dim": "A", "facet": "A3_관용", "text": "다양한 배경의 사람들과 어울리는 것이 편하다.", "reverse": false, "lite": false },
    { "id": 75, "dim": "A", "facet": "A3_관용", "text": "나와 다른 의견도 들을 가치가 있다고 생각한다.", "reverse": false, "lite": false },
    { "id": 76, "dim": "A", "facet": "A4_대인신뢰", "text": "대부분의 사람은 기본적으로 선의를 가지고 있다고 믿는다.", "reverse": false, "lite": true },
    { "id": 77, "dim": "A", "facet": "A4_대인신뢰", "text": "처음 만난 사람도 신뢰하고 대하는 편이다.", "reverse": false, "lite": false },
    { "id": 78, "dim": "A", "facet": "A4_대인신뢰", "text": "사람들은 자기 이익을 위해서라면 거짓말도 한다고 생각한다.", "reverse": true, "lite": true },
    { "id": 79, "dim": "A", "facet": "A4_대인신뢰", "text": "나는 사람들의 진심을 의심하지 않는다.", "reverse": false, "lite": false },
    { "id": 80, "dim": "A", "facet": "A4_대인신뢰", "text": "사람들은 보통 약속을 지키려고 노력한다고 본다.", "reverse": false, "lite": false },
    { "id": 81, "dim": "ES", "facet": "ES1_불안조절", "text": "걱정이 많아 잠을 설치는 일이 자주 있다.", "reverse": true, "lite": true },
    { "id": 82, "dim": "ES", "facet": "ES1_불안조절", "text": "사소한 일에도 마음이 불안해지곤 한다.", "reverse": true, "lite": false },
    { "id": 83, "dim": "ES", "facet": "ES1_불안조절", "text": "긴장되는 상황에서도 평정을 유지하는 편이다.", "reverse": false, "lite": false },
    { "id": 84, "dim": "ES", "facet": "ES1_불안조절", "text": "나는 평소 마음이 편안하고 안정되어 있다.", "reverse": false, "lite": true },
    { "id": 85, "dim": "ES", "facet": "ES1_불안조절", "text": "미래에 대한 불안감이 자주 나를 괴롭힌다.", "reverse": true, "lite": false },
    { "id": 86, "dim": "ES", "facet": "ES2_충동조절", "text": "화가 나도 말이나 행동을 자제할 수 있다.", "reverse": false, "lite": true },
    { "id": 87, "dim": "ES", "facet": "ES2_충동조절", "text": "감정이 격해지면 후회할 행동을 하기도 한다.", "reverse": true, "lite": false },
    { "id": 88, "dim": "ES", "facet": "ES2_충동조절", "text": "내 감정을 잘 다스리는 사람이라고 생각한다.", "reverse": false, "lite": false },
    { "id": 89, "dim": "ES", "facet": "ES2_충동조절", "text": "갑작스럽게 폭발적으로 화내는 일이 거의 없다.", "reverse": false, "lite": false },
    { "id": 90, "dim": "ES", "facet": "ES2_충동조절", "text": "강한 감정이 들 때도 차분히 대응할 수 있다.", "reverse": false, "lite": false },
    { "id": 91, "dim": "ES", "facet": "ES3_회복탄력성", "text": "큰 좌절을 겪어도 비교적 빨리 회복하는 편이다.", "reverse": false, "lite": true },
    { "id": 92, "dim": "ES", "facet": "ES3_회복탄력성", "text": "어려움 후에는 그것에서 배우는 점을 찾으려 한다.", "reverse": false, "lite": false },
    { "id": 93, "dim": "ES", "facet": "ES3_회복탄력성", "text": "한번 마음이 무너지면 오래 회복하기 어렵다.", "reverse": true, "lite": false },
    { "id": 94, "dim": "ES", "facet": "ES3_회복탄력성", "text": "스트레스 상황에서도 나는 다시 일어설 수 있다고 믿는다.", "reverse": false, "lite": false },
    { "id": 95, "dim": "ES", "facet": "ES3_회복탄력성", "text": "실패해도 그것을 발판 삼아 다시 도전한다.", "reverse": false, "lite": false },
    { "id": 96, "dim": "ES", "facet": "ES4_자기수용", "text": "나는 내 모습 그대로의 나를 받아들인다.", "reverse": false, "lite": true },
    { "id": 97, "dim": "ES", "facet": "ES4_자기수용", "text": "자주 자신을 비난하거나 자책한다.", "reverse": true, "lite": false },
    { "id": 98, "dim": "ES", "facet": "ES4_자기수용", "text": "내 부족한 점도 나의 일부로 인정한다.", "reverse": false, "lite": false },
    { "id": 99, "dim": "ES", "facet": "ES4_자기수용", "text": "남과 비교하며 위축되는 일이 별로 없다.", "reverse": false, "lite": false },
    { "id": 100, "dim": "ES", "facet": "ES4_자기수용", "text": "나는 나 자신에 대해 대체로 만족한다.", "reverse": false, "lite": false },
    { "id": 101, "dim": "HH", "facet": "HH1_진정성", "text": "남에게 잘 보이려고 본심을 숨기지 않는다.", "reverse": false, "lite": false },
    { "id": 102, "dim": "HH", "facet": "HH1_진정성", "text": "필요하다면 적당한 거짓말도 한다고 생각한다.", "reverse": true, "lite": false },
    { "id": 103, "dim": "HH", "facet": "HH1_진정성", "text": "내가 한 말과 행동은 일치하는 편이다.", "reverse": false, "lite": true },
    { "id": 104, "dim": "HH", "facet": "HH1_진정성", "text": "이익을 위해 진심을 감추는 일은 하지 않는다.", "reverse": false, "lite": false },
    { "id": 105, "dim": "HH", "facet": "HH1_진정성", "text": "나는 가식 없이 솔직하게 사람들을 대한다.", "reverse": false, "lite": false },
    { "id": 106, "dim": "HH", "facet": "HH2_공정성", "text": "내 이익을 위해 규칙을 어기는 일은 거의 없다.", "reverse": false, "lite": true },
    { "id": 107, "dim": "HH", "facet": "HH2_공정성", "text": "들키지 않는다면 작은 부정행위는 괜찮다고 생각한다.", "reverse": true, "lite": false },
    { "id": 108, "dim": "HH", "facet": "HH2_공정성", "text": "남의 것을 가져와서라도 이득을 보고 싶지는 않다.", "reverse": false, "lite": false },
    { "id": 109, "dim": "HH", "facet": "HH2_공정성", "text": "결과가 좋다면 수단은 별로 중요하지 않다고 본다.", "reverse": true, "lite": false },
    { "id": 110, "dim": "HH", "facet": "HH2_공정성", "text": "정정당당한 방법으로만 결과를 얻고 싶다.", "reverse": false, "lite": false },
    { "id": 111, "dim": "HH", "facet": "HH3_욕심없음", "text": "나는 특별한 대우를 받기를 기대하지 않는다.", "reverse": false, "lite": true },
    { "id": 112, "dim": "HH", "facet": "HH3_욕심없음", "text": "내 능력이 다른 사람보다 뛰어나다는 자부심이 강하다.", "reverse": true, "lite": false },
    { "id": 113, "dim": "HH", "facet": "HH3_욕심없음", "text": "사치스러운 생활은 내 관심사가 아니다.", "reverse": false, "lite": false },
