{
  "name": "prism-k",
  "version": "0.0.1",
  "private": true,
  "description": "PRISM-K 온라인 성격 검사 서비스 (모노레포)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist .next .turbo node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
